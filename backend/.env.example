# Copy this file to backend/.env and fill in the values.

# PostgreSQL (create the role/database with database/00_create_role_and_db.sql first)
DATABASE_URL=postgresql+psycopg://fitbot:CHANGE_ME@localhost:5432/fitbot_db
# For a quick local run without PostgreSQL:  DATABASE_URL=sqlite:///./fitness.db

DOCS_DIR=docs
VECTORSTORE_DIR=vectorstore

# Google Gemini (https://aistudio.google.com/apikey). Without a key the app still works:
# the coach answers with the retrieved document excerpts (degraded mode).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Total budget (seconds) of one LLM call, fallback models included
LLM_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false

# JWT signing secret: generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRE_MINUTES=1440
